        "jsCode": "const customerName = String($json.customer_name ?? \"\").trim();\n\nconst phone = String($json.phone ?? \"\").trim();\n\nconst productInterest = String(\n  $json.product_interest ?? \"\"\n).trim();\n\nconst message = String($json.message ?? \"\").trim();\n\nreturn {\n  json: {\n    ...$json,\n    customer_name: customerName,\n    phone: phone,\n    product_interest: productInterest,\n    message: message,\n    phone_provided: phone.length > 0,\n    customer_name_uppercase: customerName.toUpperCase(),\n    processed_at: new Date().toISOString()\n  }\n};"
